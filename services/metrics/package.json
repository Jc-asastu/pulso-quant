{
  "name": "@pulso/metrics",
  "version": "1.0.0",
  "private": true,
  "description": "Pure computation service: log returns, rolling volatility, max drawdown, Sharpe ratio, correlation matrix. No side effects beyond calling the ingestor over HTTP.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@pulso/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
