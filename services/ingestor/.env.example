# Port this service listens on
PORT=4001

# Cache TTL in milliseconds (default 10 minutes)
CACHE_TTL_MS=600000

# Upstream API bases (public, no key required)
COINGECKO_BASE=https://api.coingecko.com/api/v3
FRANKFURTER_BASE=https://api.frankfurter.app

# Milliseconds to wait for an upstream call before falling back
UPSTREAM_TIMEOUT_MS=5000

# Postgres connection string — the durable store of price history.
# Local: postgresql://user:pass@localhost:5432/pulso
# Neon:  postgresql://user:pass@ep-xxx.region.aws.neon.tech/pulso?sslmode=require
DATABASE_URL=

# Redis connection string — the hot cache in front of Postgres.
# Local:   redis://localhost:6379
# Upstash: rediss://default:pass@region.upstash.io:6379
REDIS_URL=

# How long stored history stays fresh before a refresh from upstream (default 12h)
SERIES_FRESH_MS=43200000
