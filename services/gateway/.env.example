# Port this service listens on
PORT=4003

# Upstream service base URLs
INGESTOR_BASE_URL=http://localhost:4001
METRICS_BASE_URL=http://localhost:4002

# CORS: comma-separated list of allowed origins (use * for local dev)
CORS_ORIGIN=*

# Milliseconds to wait for upstream services before failing
UPSTREAM_TIMEOUT_MS=10000

# Default asset universe and window when the client doesn't specify
DEFAULT_ASSETS=BTC,ETH,SOL,EURUSD,USDJPY,USDARS
DEFAULT_DAYS=90
